# Use a freshly generated URL-safe secret. Never commit the real value.
TEAM_RELAY_DB_PASSWORD=replace-with-a-long-url-safe-secret
# Generate once, keep stable, and back it up. Expected format: 32 random bytes encoded as base64url.
TEAM_RELAY_JOIN_CODE_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-secret
TEAM_RELAY_ALLOW_SELF_SERVICE_ENROLLMENT=false
# SHA-256 hex digest of the beta access code. Keep the real digest in server secrets only.
TEAM_RELAY_BETA_ACCESS_PASSWORD_HASH=
TEAM_RELAY_TRUST_PROXY=true
TEAM_RELAY_JOIN_RATE_LIMIT_FAILURES=5
TEAM_RELAY_JOIN_RATE_LIMIT_WINDOW_SECONDS=600
TEAM_RELAY_JOIN_RATE_LIMIT_BLOCK_SECONDS=900
TEAM_RELAY_AVATAR_PROCESSING_CONCURRENCY=2
TEAM_RELAY_AVATAR_UPLOAD_RATE_LIMIT_ATTEMPTS=6
TEAM_RELAY_AVATAR_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
