TEAM_RELAY_DATABASE_URL=postgresql://team_relay:change-me@127.0.0.1:5432/team_relay
TEAM_RELAY_HOST=127.0.0.1
TEAM_RELAY_PORT=8791
TEAM_RELAY_PUBLIC_BASE_PATH=/pinvou3/team-relay
TEAM_RELAY_TRUST_PROXY=false
TEAM_RELAY_JOIN_RATE_LIMIT_FAILURES=5
TEAM_RELAY_JOIN_RATE_LIMIT_WINDOW_SECONDS=600
TEAM_RELAY_JOIN_RATE_LIMIT_BLOCK_SECONDS=900
# 32 random bytes encoded as base64url. Keep this stable and backed up.
TEAM_RELAY_JOIN_CODE_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-secret
TEAM_RELAY_DB_SSL=false
TEAM_RELAY_ALLOW_SELF_SERVICE_ENROLLMENT=false
# SHA-256 hex digest of the beta access code. Keep the real digest in server secrets only.
TEAM_RELAY_BETA_ACCESS_PASSWORD_HASH=
TEAM_RELAY_ATTACHMENT_DIR=/var/lib/pinvou-team-relay/attachments
TEAM_RELAY_MAX_ATTACHMENT_BYTES=20971520
TEAM_RELAY_MAX_AVATAR_BYTES=1572864
TEAM_RELAY_AVATAR_PROCESSING_CONCURRENCY=2
TEAM_RELAY_AVATAR_UPLOAD_RATE_LIMIT_ATTEMPTS=6
TEAM_RELAY_AVATAR_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
TEAM_RELAY_MAX_TEAM_ATTACHMENT_BYTES=2147483648
TEAM_RELAY_ORPHAN_ATTACHMENT_HOURS=24
TEAM_RELAY_CLOSED_ATTACHMENT_DAYS=30
