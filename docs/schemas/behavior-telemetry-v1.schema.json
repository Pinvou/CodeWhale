{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinvou.com/schemas/behavior-telemetry-v1.schema.json",
  "title": "Pinvou Agent behavior telemetry event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_name",
    "event_source",
    "occurred_at",
    "collection_period_id",
    "producer",
    "producer_version",
    "app_version",
    "platform",
    "arch",
    "channel",
    "locale"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id128" },
    "event_name": { "enum": [
      "analytics_cohort_started", "app_opened", "onboarding_started", "onboarding_completed",
      "onboarding_skipped", "provider_setup_started", "provider_setup_completed",
      "provider_setup_failed", "task_environment_ready", "task_submitted", "task_admitted",
      "task_rejected", "task_first_output", "task_cancel_requested", "task_finished",
      "task_retry_requested", "voice_entry_clicked", "voice_permission_result", "voice_started",
      "voice_recognition_completed", "voice_recognition_failed", "voice_message_submitted",
      "voice_cancelled", "tool_impression", "tool_detail_opened", "tool_install_started",
      "tool_install_completed", "tool_configuration_started", "tool_configuration_finished",
      "tool_call_started", "tool_call_completed", "scene_impression", "scene_selected",
      "scene_submitted", "model_selected", "model_used", "model_fallback_occurred",
      "attachment_added", "attachment_processing_completed", "knowledge_import_started",
      "knowledge_import_completed", "artifact_created", "artifact_exported", "code_mode_opened",
      "scheduled_task_created", "scheduled_task_run_finished", "team_mode_opened",
      "response_feedback_changed", "response_copied", "remote_control_event"
    ] },
    "event_source": { "const": "client" },
    "occurred_at": { "type": "integer", "minimum": 1 },
    "received_at": { "type": "integer", "minimum": 1 },
    "device_id": { "$ref": "#/$defs/id96" },
    "account_subject_id": { "$ref": "#/$defs/id96" },
    "collection_period_id": { "$ref": "#/$defs/id96" },
    "producer": { "const": "pinvou_agent" },
    "producer_version": { "$ref": "#/$defs/text48" },
    "environment": { "enum": ["production", "staging", "development", "test"] },
    "app_version": { "$ref": "#/$defs/text48" },
    "platform": { "enum": ["windows", "macos", "linux", "web"] },
    "arch": { "enum": ["x86_64", "aarch64", "unknown"] },
    "channel": { "enum": ["stable", "beta", "dev", "unknown"] },
    "locale": { "enum": ["zh-CN", "en", "ja"] },
    "session_id": { "$ref": "#/$defs/id96" },
    "attempt_id": { "$ref": "#/$defs/id96" },
    "turn_id": { "$ref": "#/$defs/id96" },
    "operation_id": { "$ref": "#/$defs/id96" },
    "attempt_index": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "view_id": { "$ref": "#/$defs/id96" },
    "entry_point": { "enum": ["onboarding", "composer", "sidebar", "settings", "marketplace", "scene_gallery", "context_menu", "notification", "deep_link", "unknown"] },
    "mode": { "enum": ["assistant", "code", "scheduled", "team", "system"] },
    "initiator_type": { "enum": ["user", "schedule", "team", "system"] },
    "input_type": { "enum": ["text", "voice", "attachment", "mixed", "system"] },
    "status": { "enum": ["success", "failed", "cancelled", "interrupted"] },
    "duration_ms": { "$ref": "#/$defs/duration" },
    "queue_duration_ms": { "$ref": "#/$defs/duration" },
    "error_category": { "$ref": "#/$defs/errorCategory" },
    "stage": { "enum": ["submission", "queue", "permission", "recording", "recognition", "model", "tool", "output", "shutdown", "unknown"] },
    "success": { "type": "boolean" },
    "eligibility_source": { "enum": ["first_open", "later_opt_in", "managed_policy"] },
    "install_source": { "enum": ["direct", "store", "managed", "upgrade", "unknown"] },
    "previous_version_present": { "type": "boolean" },
    "launch_type": { "enum": ["cold", "auto_update", "recovery", "unknown"] },
    "startup_duration_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
    "provider_configured": { "type": "boolean" },
    "provider_key": { "$ref": "#/$defs/registryKey" },
    "model_key": { "$ref": "#/$defs/registryKey" },
    "from_model_key": { "$ref": "#/$defs/registryKey" },
    "to_model_key": { "$ref": "#/$defs/registryKey" },
    "tool_key": { "$ref": "#/$defs/registryKey" },
    "tool_name": { "$ref": "#/$defs/normalizedToolName" },
    "step": { "$ref": "#/$defs/registryKey" },
    "readiness_source": { "enum": ["built_in", "provider_setup", "managed_policy", "migrated_config"] },
    "has_attachment": { "type": "boolean" },
    "output_type": { "enum": ["text", "artifact", "mixed"] },
    "source_turn_id": { "$ref": "#/$defs/id96" },
    "retry_reason": { "enum": ["manual_regenerate", "previous_failed", "input_changed", "unknown"] },
    "voice_permission_status": { "enum": ["granted", "denied", "restricted", "error"] },
    "recognizer_type": { "enum": ["local", "cloud", "system", "unknown"] },
    "length_bucket": { "enum": ["1_20", "21_100", "101_500", "500_plus"] },
    "tool_type": { "enum": ["mcp", "cli", "skill", "builtin", "custom", "unknown"] },
    "position_bucket": { "enum": ["1_3", "4_10", "11_plus"] },
    "scene_l1": { "$ref": "#/$defs/registryKey" },
    "scene_l2": { "$ref": "#/$defs/registryKey" },
    "selection_scope": { "enum": ["session", "app_default"] },
    "selection_source": { "enum": ["user_selected", "session_default", "app_default", "system_routed", "fallback"] },
    "attachment_id": { "$ref": "#/$defs/id96" },
    "file_type_bucket": { "enum": ["document", "spreadsheet", "presentation", "pdf", "image", "archive", "code", "other"] },
    "size_bucket": { "enum": ["0_1mib", "1_10mib", "10_100mib", "100mib_plus"] },
    "source_type": { "enum": ["file", "folder", "connector", "unknown"] },
    "item_count_bucket": { "$ref": "#/$defs/countBucket" },
    "artifact_id": { "$ref": "#/$defs/id96" },
    "artifact_type": { "enum": ["document", "spreadsheet", "slides", "pdf", "image", "code", "html", "other"] },
    "export_format": { "enum": ["docx", "xlsx", "pptx", "pdf", "png", "html", "markdown", "other"] },
    "scheduled_task_id": { "$ref": "#/$defs/id96" },
    "schedule_type": { "enum": ["once", "daily", "weekly", "monthly", "cron"] },
    "task_type": { "$ref": "#/$defs/registryKey" },
    "member_count_bucket": { "enum": ["1", "2_3", "4_8", "9_plus"] },
    "feedback_id": { "$ref": "#/$defs/id96" },
    "feedback_action": { "enum": ["set", "clear"] },
    "rating": { "enum": ["positive", "negative"] },
    "reason_code": { "enum": ["accurate", "helpful", "fast", "incorrect", "incomplete", "unsafe", "too_slow", "other"] },
    "content_type": { "enum": ["text", "code", "table", "other"] },
    "remote_stage": { "enum": ["start", "stop", "refresh", "claim", "handshake", "connection", "disconnection", "resume", "task_submit", "task_admit", "task_terminal", "permission", "attachment", "artifact"] },
    "remote_outcome": { "enum": ["ok", "rejected", "timeout", "busy", "expired", "unsupported", "internal_error"] },
    "remote_reason": { "enum": ["none", "not_enrolled", "code_invalid", "slot_conflict", "handshake_failed", "receipt_mismatch", "liveness_missing", "watchdog_expired", "resume_failed", "task_conflict", "permission_denied", "permission_timeout", "transfer_budget", "artifact_missing", "rate_limited", "unknown"] },
    "remote_latency_bucket": { "enum": ["lt_50ms", "lt_250ms", "lt_1s", "lt_5s", "lt_30s", "gte_30s"] },
    "remote_model_source": { "enum": ["controlled", "controller_temporary"] },
    "remote_size_bucket": { "enum": ["0_1mib", "1_10mib", "10_100mib", "100mib_plus"] },
    "remote_permission_step": { "enum": ["request", "allowed", "denied", "expired"] },
    "clock_skew_bucket": { "enum": ["normal", "past_1h_plus", "future_5m_plus", "unknown"] }
  },
  "$defs": {
    "id96": { "type": "string", "pattern": "^[A-Za-z0-9_-]{12,128}$" },
    "id128": { "type": "string", "pattern": "^[A-Za-z0-9_-]{20,96}$" },
    "registryKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "normalizedToolName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$" },
    "text48": { "type": "string", "minLength": 1, "maxLength": 48 },
    "duration": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "countBucket": { "enum": ["0", "1", "2_10", "11_100", "100_plus"] },
    "errorCategory": { "enum": ["permission_denied", "authentication_failed", "configuration_missing", "network_unavailable", "timeout", "rate_limited", "provider_error", "model_error", "tool_error", "unsupported", "user_cancelled", "validation_failed", "internal_error", "unknown"] }
  },
  "x-client-optional-fields": [
    "session_id", "attempt_id", "turn_id", "operation_id", "attempt_index",
    "view_id", "entry_point", "mode", "initiator_type", "input_type", "status", "duration_ms",
    "queue_duration_ms", "error_category", "stage", "success", "eligibility_source", "install_source",
    "previous_version_present", "launch_type", "startup_duration_ms", "provider_configured", "provider_key",
    "model_key", "from_model_key", "to_model_key", "tool_key", "tool_name", "step", "readiness_source",
    "has_attachment", "output_type", "source_turn_id", "retry_reason", "voice_permission_status",
    "recognizer_type", "length_bucket", "tool_type", "position_bucket", "scene_l1", "scene_l2",
    "selection_scope", "selection_source", "attachment_id", "file_type_bucket", "size_bucket",
    "source_type", "item_count_bucket", "artifact_id", "artifact_type", "export_format",
    "scheduled_task_id", "schedule_type", "task_type", "member_count_bucket", "feedback_id",
    "feedback_action", "rating", "reason_code", "content_type", "remote_stage",
    "remote_outcome", "remote_reason", "remote_latency_bucket", "remote_model_source",
    "remote_size_bucket", "remote_permission_step"
  ],
  "x-server-injected-fields": ["received_at", "device_id", "account_subject_id", "environment", "clock_skew_bucket"],
  "x-event-contracts": {
    "analytics_cohort_started": { "required": ["eligibility_source", "install_source", "previous_version_present"] },
    "app_opened": { "required": ["launch_type", "startup_duration_ms"] },
    "onboarding_started": { "required": ["entry_point"] },
    "onboarding_completed": { "required": ["duration_ms", "provider_configured"] },
    "onboarding_skipped": { "required": ["step", "duration_ms"] },
    "provider_setup_started": { "required": ["provider_key", "entry_point", "operation_id", "attempt_index"] },
    "provider_setup_completed": { "required": ["provider_key", "operation_id", "attempt_index", "duration_ms"] },
    "provider_setup_failed": { "required": ["provider_key", "operation_id", "attempt_index", "error_category"] },
    "task_environment_ready": { "required": ["readiness_source", "provider_key"] },
    "task_submitted": { "required": ["session_id", "attempt_id", "mode", "initiator_type", "input_type", "has_attachment"] },
    "task_admitted": { "required": ["session_id", "attempt_id", "turn_id", "queue_duration_ms", "mode", "initiator_type", "input_type", "has_attachment"] },
    "task_rejected": { "required": ["session_id", "attempt_id", "error_category", "stage", "mode", "initiator_type", "input_type", "has_attachment"] },
    "task_first_output": { "required": ["session_id", "attempt_id", "turn_id", "output_type", "duration_ms", "mode", "initiator_type", "input_type", "has_attachment"] },
    "task_cancel_requested": { "required": ["session_id", "attempt_id", "turn_id", "stage"] },
    "task_finished": { "required": ["session_id", "attempt_id", "turn_id", "status", "duration_ms", "mode", "initiator_type", "input_type", "has_attachment"] },
    "task_retry_requested": { "required": ["session_id", "attempt_id", "source_turn_id", "retry_reason"] },
    "voice_entry_clicked": { "required": ["session_id", "operation_id", "entry_point"] },
    "voice_permission_result": { "required": ["session_id", "operation_id", "voice_permission_status"] },
    "voice_started": { "required": ["session_id", "operation_id"] },
    "voice_recognition_completed": { "required": ["operation_id", "duration_ms", "recognizer_type"] },
    "voice_recognition_failed": { "required": ["operation_id", "duration_ms", "error_category"] },
    "voice_message_submitted": { "required": ["operation_id", "session_id", "attempt_id"] },
    "voice_cancelled": { "required": ["operation_id", "stage", "duration_ms"] },
    "tool_impression": { "required": ["view_id", "tool_key", "tool_type", "entry_point", "position_bucket"] },
    "tool_detail_opened": { "required": ["view_id", "tool_key", "tool_type", "entry_point"] },
    "tool_install_started": { "required": ["tool_key", "tool_type", "operation_id", "attempt_index"] },
    "tool_install_completed": { "required": ["tool_key", "tool_type", "operation_id", "attempt_index", "success", "duration_ms"] },
    "tool_configuration_started": { "required": ["tool_key", "tool_type", "operation_id", "attempt_index", "entry_point"] },
    "tool_configuration_finished": { "required": ["tool_key", "tool_type", "operation_id", "attempt_index", "success", "duration_ms"] },
    "tool_call_started": { "required": ["session_id", "turn_id", "operation_id", "attempt_index", "tool_key", "tool_type"] },
    "tool_call_completed": { "required": ["session_id", "turn_id", "operation_id", "attempt_index", "tool_key", "tool_type", "success", "duration_ms"] },
    "scene_impression": { "required": ["view_id", "scene_l1", "scene_l2", "entry_point"] },
    "scene_selected": { "required": ["view_id", "scene_l1", "scene_l2", "entry_point"] },
    "scene_submitted": { "required": ["scene_l1", "scene_l2", "session_id", "attempt_id"] },
    "model_selected": { "required": ["provider_key", "model_key", "selection_scope", "entry_point"] },
    "model_used": { "required": ["session_id", "attempt_id", "turn_id", "provider_key", "model_key", "selection_source"] },
    "model_fallback_occurred": { "required": ["session_id", "attempt_id", "turn_id", "from_model_key", "to_model_key", "error_category"] },
    "attachment_added": { "required": ["attachment_id", "operation_id", "attempt_index", "file_type_bucket", "size_bucket", "entry_point"] },
    "attachment_processing_completed": { "required": ["attachment_id", "operation_id", "attempt_index", "file_type_bucket", "success", "duration_ms"] },
    "knowledge_import_started": { "required": ["operation_id", "attempt_index", "source_type", "item_count_bucket"] },
    "knowledge_import_completed": { "required": ["operation_id", "attempt_index", "success", "duration_ms"] },
    "artifact_created": { "required": ["artifact_id", "session_id", "turn_id", "artifact_type"] },
    "artifact_exported": { "required": ["artifact_id", "session_id", "turn_id", "artifact_type", "export_format"] },
    "code_mode_opened": { "required": ["view_id", "session_id", "entry_point", "provider_key"] },
    "scheduled_task_created": { "required": ["scheduled_task_id", "schedule_type", "task_type"] },
    "scheduled_task_run_finished": { "required": ["scheduled_task_id", "operation_id", "attempt_index", "status", "duration_ms"] },
    "team_mode_opened": { "required": ["view_id", "session_id", "member_count_bucket", "entry_point"] },
    "response_feedback_changed": { "required": ["feedback_id", "session_id", "turn_id", "feedback_action"] },
    "response_copied": { "required": ["session_id", "turn_id", "content_type"] },
    "remote_control_event": {
      "required": ["remote_stage", "remote_outcome", "remote_reason", "remote_latency_bucket"],
      "allowed": ["remote_stage", "remote_outcome", "remote_reason", "remote_latency_bucket", "remote_model_source", "remote_size_bucket", "remote_permission_step"]
    }
  }
}
