# 模型商店开机自启恢复器（systemd user 服务，2026-10-23）。
# 由 deb 打包安装到 /usr/lib/systemd/user/；postinst 已 enable-linger，
# 设备重启后无需用户登录即触发。拉起逻辑在应用内（autostart_pending）。
#
# r6 P1-3.2：**不写任何 system-manager 单元依赖**——user manager 不管理
# docker.service/network-online.target，`After=`/`Wants=` 引用它们是静默
# no-op（反而误导读者以为有顺序保证）。docker 就绪等待由 ExecStart 内部
# 做有界轮询（autostart_pending 开头的 docker 等待，覆盖 tachyon 原生卡
# 不依赖 docker 的场景），TimeoutStartSec=1800 为等待+加载给足预算。
[Unit]
Description=Pinvou Model Store autostart (restore running models after reboot)

[Service]
Type=oneshot
# 品悟主二进制 headless 子命令（不启 GUI；内部自带 docker 有界等待）
ExecStart=/usr/bin/pinvou3-tauri model-store-autostart
RemainAfterExit=yes
# 失败不无限重试：结构化结果已落库，GUI 打开后按结果弹窗（要求②）
Restart=no
TimeoutStartSec=1800
# 大模型加载动辄几分钟，给足时间
Nice=5

[Install]
WantedBy=default.target
