.githooks/* text eol=lf
# Portal HTML is a Vite input and an embedded generated asset; keep build bytes consistent.
pinvou3-app/src/account.html text eol=lf
account-platform/internal/portal/static/** text eol=lf
scripts/validate-commit-msg.py text eol=lf
# Shell 脚本必须 LF:core.autocrlf=true 的 Windows checkout 会把 .sh 转成 CRLF,
# 严格模式的 bash 读到 \r 直接失败(fork-guard.sh 等 PR 门控脚本跑不起来)。
*.sh text eol=lf
pinvou3-app/src-tauri/resources/platforms/linux/knowledge-host/pinvou-knowledge-host-helper text eol=lf
# 编译期 include_str! 内嵌并按 "\n\n" 切分/golden 字节测试锁定:autocrlf=true 的
# Windows checkout 转成 CRLF 后 split_once("\n\n") 直接 panic。
pinvou3-app/src-tauri/resources/common/bundle/instructions-*.md text eol=lf
# Third-party skill trees must stay byte-identical to their upstream
# zip/tar archives, so merge tools must not rewrite line endings; CRLF
# noise would distort diffs/review and resurface as line-by-line
# conflicts on the next sync.
pinvou3-app/src-tauri/resources/common/bundle/*-skills/** text eol=lf
# Vendored browser assets ship byte-exact and are locked to the SHA-256
# registry in pinvou3-app/src/vendor/README.md (enforced by
# pinvou3-app/tests/vendor_asset_integrity.test.js); a core.autocrlf=true
# checkout would rewrite line endings and break that contract.
pinvou3-app/src/vendor/*.js text eol=lf
# The vendor script rewrites this tracked placeholder after replacing its
# directory; pin LF so its embedded GITKEEP bytes are identical on all hosts.
pinvou3-app/src-tauri/resources/platforms/windows/chrome-devtools-mcp/.gitkeep text eol=lf
# 内置测试商店的卡片包是厂商交付物，**字节级锁定**：每个包自带 SHA256SUMS，
# 而 test_store_data.rs 用 include_str! 在编译期内嵌这些文件，并有一条测试
# 逐个核对哈希。core.autocrlf=true 的 Windows checkout 把它们转成 CRLF 之后，
# 哈希全部对不上——仓库里存的 blob 是对的，只有工作区被改写了，所以现象是
# 「Linux CI 全绿、Windows 上一测就红」。跟上面 *-skills 和 vendor/*.js 同理。
pinvou3-app/src-tauri/src/features/model_store/data/test-store/** text eol=lf
# Workflow YAML 会被策略/路由测试逐行正则解析(scripts/tests/pr-check-routing.test.mjs、
# test_ci_gate_policy.py 等):core.autocrlf=true 的 Windows checkout 转成 CRLF 后
# 正则失配、守卫空转,与上方钩子/Shell 脚本同理钉 LF。
.github/workflows/*.yml text eol=lf
