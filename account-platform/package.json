{
  "name": "pinvou-account-platform-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:openapi": "redocly lint contracts/openapi/account.yaml contracts/openapi/identity.yaml contracts/openapi/billing.yaml contracts/openapi/token-gateway.yaml contracts/openapi/admin.yaml",
    "test:contracts": "node --test test/contract/*.test.mjs",
    "check:i18n-release": "node ../scripts/check-account-platform-i18n.mjs",
    "check:observability-release": "node ../scripts/check-account-platform-observability.mjs",
    "security:production-readiness": "node ../scripts/account-platform-production-security-gate.mjs",
    "test": "npm run lint:openapi && npm run test:contracts"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
