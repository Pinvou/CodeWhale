# Include in the existing Portal HTTPS server; keep both payment routes intact.
# Application supplies exact build-pinned CSP and Referrer-Policy: origin.
location = /credential-handoff {
    access_log __ACCESS_LOG__ pinvou_credential_safe;
    error_log /dev/null crit;
    __HANDOFF_ERROR_ROUTES__
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    if ($request_method !~ ^(GET|HEAD)$) { return 404; }
    if ($request_uri != "/credential-handoff") { return 404; }
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    __PORTAL_UPSTREAM__
}
location ^~ /credential-handoff {
    __HANDOFF_ERROR_ROUTES__
    return 404;
}
__HANDOFF_ERRORS__
