# Legacy loopback upstream layout, with the same approved TLS-only public edge.
# Render the verified DNS host and nonprivileged public TLS port (1024-65535).
# Certificate/private key are supplied through the existing private TLS mount.
server {
    listen __PUBLIC_TLS_PORT__ ssl;
    listen [::]:__PUBLIC_TLS_PORT__ ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /run/pinvou/public-tls/server.crt;
    ssl_certificate_key /run/pinvou/public-tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    if ($host != "__PUBLIC_HOST__") { return 421; }

    client_max_body_size 4m;

    # Account and Token private APIs stay off the public edge, including bare
    # prefixes. Public administration continues through the Portal ingress.
    location = /account/internal { return 404; }
    location ^~ /account/internal/ {
        return 404;
    }
    location = /account/admin { return 404; }
    location ^~ /account/admin/ { return 404; }
    location = /token/internal { return 404; }
    location ^~ /token/internal/ { return 404; }
    location = /token/admin { return 404; }
    location ^~ /token/admin/ { return 404; }

    location = /api/v1/payment-callback/token {
        client_max_body_size 8k;
        proxy_pass http://127.0.0.1:18102;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location = /api/v1/payment-callbacks {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:18102;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location = /realms/pinvou/protocol/openid-connect/token {
        proxy_pass http://127.0.0.1:18107;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /realms/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /resources/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /account/ {
        rewrite ^/account/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:18101;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location = /identity/v1/registration/password-prechecks {
        rewrite ^/identity/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:18107;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }

    location /token/ {
        rewrite ^/token/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:18103;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /pay/ {
        proxy_pass http://127.0.0.1:18104;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Portal is the trusted Token-admin ingress. This external ceiling preserves
    # the longest 10s business + 2s BFF + 2s ingress chain; Portal itself applies
    # the exact 14/7/9s class deadline and never trusts a client deadline header.
    location ^~ /api/admin/token/ {
        proxy_pass http://127.0.0.1:18105;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Absolute-Deadline "";
        proxy_set_header X-Pinvou-Deadline-Class "";
        proxy_set_header X-Pinvou-Client-Source $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_send_timeout 14s;
        proxy_read_timeout 14s;
    }

    location / {
        proxy_pass http://127.0.0.1:18105;
        proxy_http_version 1.1;
        proxy_set_header Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Host "__PUBLIC_HOST__:__PUBLIC_TLS_PORT__";
        proxy_set_header X-Forwarded-Port __PUBLIC_TLS_PORT__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Pinvou-Client-Source $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }
}
