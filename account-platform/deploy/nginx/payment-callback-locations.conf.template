# Include this file inside the HTTPS server block for account.pinvou.com.
# Replace __BILLING_UPSTREAM__ with a controlled upstream such as
# http://127.0.0.1:18102. Do not expose the Billing port directly.

location = /api/v1/payment-callback/token {
    client_max_body_size 8k;
    proxy_pass __BILLING_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
}

location = /api/v1/payment-callbacks {
    client_max_body_size 1m;
    proxy_pass __BILLING_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
}
