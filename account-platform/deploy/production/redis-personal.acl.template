# Substitute only independently generated SHA256 password hashes, not passwords.
# The default user stays disabled. Each client uses its own TLS authenticated URL.
user default reset off
user portal reset on #PORTAL_PASSWORD_SHA256 ~portal:flow:* ~portal:session:* ~portal:session-root:* ~portal:lineage-members:* ~portal:logout:* ~portal:session-handoff:* ~portal:refresh:* +ping +hello +client|setname +client|setinfo +get +getdel +set +del +exists +sadd +smembers +pttl +pexpire +eval +evalsha
user identity reset on #IDENTITY_PASSWORD_SHA256 ~pinvou:auth-admission:* ~pinvou:auth-failure:* ~pinvou:auth-alias:* +ping +hello +client|setname +client|setinfo +get +set +incr +expire +ttl +eval +evalsha
