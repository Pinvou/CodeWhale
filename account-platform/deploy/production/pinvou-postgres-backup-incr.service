[Unit]
Description=Pinvou daily encrypted PostgreSQL incremental backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pinvou-postgres-backup/account-platform-postgres-backup-job.py incr --wait-lock
UMask=0077
LimitCORE=0
TimeoutStartSec=6400
MemoryMax=256M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pinvou-postgres-backup/state
RestrictAddressFamilies=AF_UNIX
