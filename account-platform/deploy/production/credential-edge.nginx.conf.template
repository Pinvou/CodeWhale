# Render only the approved credentials origin DNS hostname and private TLS paths.
# No access/error request logs: launch proof, authorization code and secret body
# must not enter diagnostics. This independent site never proxies business APIs.
pid /tmp/nginx.pid;
error_log /dev/null crit;
worker_processes auto;
events { worker_connections 512; }
http {
  access_log off;
  client_body_temp_path /tmp/client-body;
  proxy_temp_path /tmp/proxy;
  client_max_body_size 64k;
  server_tokens off;
  server {
    listen 8443 ssl default_server;
    server_name __CREDENTIAL_PUBLIC_HOST__;
    ssl_certificate /run/pinvou/tls/server.crt;
    ssl_certificate_key /run/pinvou/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Only the configured approved host can reach this isolated authority.
    if ($host != "__CREDENTIAL_PUBLIC_HOST__") { return 421; }
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    location ~ ^/(launch|session|credentials|oidc/callback|assets/credential\.(css)|assets/credential-(auth|submit)\.js)$ {
      proxy_pass http://token-credential-portal:8080;
      proxy_set_header Host __CREDENTIAL_PUBLIC_HOST__;
      proxy_set_header X-Forwarded-Host __CREDENTIAL_PUBLIC_HOST__;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Pinvou-Client-Source $remote_addr;
      proxy_set_header Authorization "";
      proxy_set_header X-Pinvou-Internal-Service-Token "";
      proxy_connect_timeout 3s;
      proxy_read_timeout 12s;
      proxy_send_timeout 12s;
    }
    location / { return 404; }
  }
}
