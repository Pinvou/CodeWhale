# Render only into a private directory, never into the public deployment tree.
[global]
repo1-path=/var/lib/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=@REPOSITORY_CIPHER_PASS@
repo1-retention-full-type=time
repo1-retention-full=35
expire-auto=n
archive-check=y
archive-async=n
archive-timeout=45
start-fast=y
process-max=1
compress-type=zst
compress-level=3
log-level-console=error
log-level-file=off
lock-path=/var/run/postgresql/pgbackrest

[platform]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user=account_platform_admin
pg1-database=postgres
