# Copy to .env and replace every placeholder with a distinct random value.
# Database passwords must be URL-safe, because Compose embeds them in DSNs.
ACCOUNT_PLATFORM_POSTGRES_PASSWORD=replace-with-random-admin-password
ACCOUNT_DB_PASSWORD=replace-with-random-account-password
BILLING_DB_PASSWORD=replace-with-random-billing-password
TOKEN_DB_PASSWORD=replace-with-random-token-password
PAYMENT_SIM_DB_PASSWORD=replace-with-random-simulator-password
KEYCLOAK_DB_PASSWORD=replace-with-random-keycloak-db-password
KEYCLOAK_ADMIN_USERNAME=replace-with-local-admin-name
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-keycloak-admin-password
INTERNAL_SERVICE_TOKEN=replace-with-random-internal-service-token
PAYMENT_SIM_HMAC_UNIONPAY=replace-with-random-unionpay-hmac
PAYMENT_SIM_HMAC_ALIPAY=replace-with-random-alipay-hmac
PAYMENT_SIM_HMAC_WECHAT=replace-with-random-wechat-hmac
PAYMENT_SIM_PAY_TOKEN_SECRET=replace-with-random-pay-token-secret
TOKEN_LOCAL_KEK_BASE64=replace-with-base64-encoded-32-random-bytes
MOCK_NEWAPI_KEY=replace-with-random-mock-newapi-key
