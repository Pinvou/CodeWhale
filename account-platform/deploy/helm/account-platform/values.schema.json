{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "images",
    "newApi",
    "oidc",
    "public",
    "observability",
    "security",
    "billing",
    "tokenGateway",
    "external",
    "ingress",
    "keycloak",
    "networkPolicy",
    "mobileAuth",
    "commerce",
    "account",
    "replicas"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "environment",
        "runtimeSecret"
      ],
      "properties": {
        "environment": {
          "enum": [
            "development",
            "test",
            "staging",
            "production-new"
          ]
        },
        "runtimeSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "accountService",
        "billingService",
        "tokenGateway",
        "tokenPortal",
        "eventRelay",
        "migrate",
        "newApi",
        "keycloak",
        "redis",
        "nats",
        "newApiTls",
        "identityService"
      ],
      "additionalProperties": false,
      "properties": {
        "accountService": {
          "$ref": "#/definitions/image"
        },
        "billingService": {
          "$ref": "#/definitions/image"
        },
        "tokenGateway": {
          "$ref": "#/definitions/image"
        },
        "tokenPortal": {
          "$ref": "#/definitions/image"
        },
        "eventRelay": {
          "$ref": "#/definitions/image"
        },
        "migrate": {
          "$ref": "#/definitions/image"
        },
        "newApi": {
          "$ref": "#/definitions/imageWithDigest"
        },
        "keycloak": {
          "$ref": "#/definitions/image"
        },
        "redis": {
          "$ref": "#/definitions/image"
        },
        "nats": {
          "$ref": "#/definitions/image"
        },
        "newApiTls": {
          "$ref": "#/definitions/image"
        },
        "identityService": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "newApi": {
      "type": "object",
      "required": [
        "enabled",
        "serviceName",
        "replicas",
        "nodeType",
        "trustedProxies",
        "tls"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "nodeType": {
          "enum": [
            "master",
            "slave"
          ]
        },
        "trustedProxies": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "serverSecretName",
            "caSecretName"
          ],
          "additionalProperties": false,
          "properties": {
            "serverSecretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "caSecretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "required": [
        "issuer",
        "jwksUrl",
        "tokenUrl",
        "audience",
        "portalClientId"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "jwksUrl": {
          "type": "string"
        },
        "tokenUrl": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "portalClientId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "public": {
      "type": "object",
      "required": [
        "portalUrl",
        "paymentCallbackUrl"
      ],
      "properties": {
        "portalUrl": {
          "type": "string",
          "format": "uri"
        },
        "paymentCallbackUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "otlpEndpoint",
        "prometheusRulesEnabled"
      ],
      "properties": {
        "otlpEndpoint": {
          "type": "string"
        },
        "prometheusRulesEnabled": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "rateLimitRPS",
        "rateLimitBurst"
      ],
      "properties": {
        "rateLimitRPS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "rateLimitBurst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "billing": {
      "type": "object",
      "required": [
        "paymentExpiryIntervalSeconds",
        "paymentProvider",
        "allowTentativePrices"
      ],
      "additionalProperties": false,
      "properties": {
        "paymentExpiryIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "paymentProvider": {
          "enum": [
            "simulator",
            "h3c_mall"
          ]
        },
        "allowTentativePrices": {
          "type": "boolean"
        }
      }
    },
    "tokenGateway": {
      "type": "object",
      "required": [
        "secretProvider",
        "secretKeyId",
        "providerAllowedHosts",
        "maxInputTokens",
        "defaultProviderBaseUrl",
        "reconciliationNewApiBaseUrl"
      ],
      "properties": {
        "secretProvider": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "secretKeyId": {
          "type": "string"
        },
        "providerAllowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "defaultProviderBaseUrl": {
          "type": "string",
          "format": "uri"
        },
        "reconciliationNewApiBaseUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "external": {
      "type": "object",
      "required": [
        "oidcCidrs",
        "postgresCidrs",
        "paymentProviderCidrs",
        "secretProviderCidrs",
        "modelProviderCidrs",
        "telemetryCollectorCidrs"
      ],
      "properties": {
        "oidcCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "postgresCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "paymentProviderCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "secretProviderCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "modelProviderCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "telemetryCollectorCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "smsProviderCidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "commerceProviderCidrs": {
          "$ref": "#/definitions/cidrs"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "identityHost"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "identityHost": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keycloak": {
      "type": "object",
      "required": [
        "hostname",
        "adminHostname"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "format": "uri"
        },
        "adminHostname": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "mobileAuth": {
      "type": "object",
      "required": [
        "enabled",
        "smsProvider",
        "smsEndpoint",
        "keycloakAdminApiUrl",
        "keycloakProvisionerTokenUrl",
        "keycloakRealm",
        "keycloakProvisionerClientId",
        "aliyunEndpoint",
        "aliyunRegisterTemplate",
        "aliyunLoginTemplate"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "smsProvider": {
          "enum": [
            "http",
            "aliyun",
            "aliyun-managed",
            "http-generated"
          ]
        },
        "smsEndpoint": {
          "type": "string"
        },
        "keycloakAdminApiUrl": {
          "type": "string"
        },
        "keycloakProvisionerTokenUrl": {
          "type": "string"
        },
        "keycloakRealm": {
          "type": "string",
          "minLength": 1
        },
        "keycloakProvisionerClientId": {
          "type": "string",
          "minLength": 1
        },
        "aliyunEndpoint": {
          "type": "string",
          "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
        },
        "aliyunRegisterTemplate": {
          "type": "string"
        },
        "aliyunLoginTemplate": {
          "type": "string"
        },
        "aliyunProfileMobileTemplate": {
          "type": "string"
        },
        "aliyunPasswordResetTemplate": {
          "type": "string"
        }
      }
    },
    "commerce": {
      "type": "object",
      "required": [
        "enabled",
        "baseUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        }
      }
    },
    "account": {
      "type": "object",
      "required": [
        "walletProvisioningPolicyVersion",
        "walletProvisioningSlaMinutes",
        "commerceProviderId",
        "commerceAdapterVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "walletProvisioningPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "walletProvisioningSlaMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "commerceProviderId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "commerceAdapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "replicas": {
      "type": "object",
      "required": [
        "identityService"
      ],
      "properties": {
        "identityService": {
          "type": "integer",
          "const": 1
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imageWithDigest": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest",
              "dev",
              "release-required"
            ]
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "cidrs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^.+/.+$"
          },
          {
            "not": {
              "enum": [
                "0.0.0.0/0",
                "::/0"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "environment": {
                "enum": [
                  "staging",
                  "production-new"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "oidc": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+(/[^?#]*)?$"
              },
              "jwksUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+/[^?#]*$"
              },
              "tokenUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+/[^?#]*$"
              }
            }
          },
          "tokenGateway": {
            "type": "object",
            "properties": {
              "defaultProviderBaseUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+(:[0-9]+)?$"
              },
              "reconciliationNewApiBaseUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+(:[0-9]+)?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "environment": {
                "const": "production-new"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tokenGateway": {
            "type": "object",
            "properties": {
              "secretProvider": {
                "const": "remote"
              },
              "secretKeyId": {
                "type": "string",
                "minLength": 1
              },
              "providerAllowedHosts": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "newApi": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "billing": {
            "type": "object",
            "properties": {
              "allowTentativePrices": {
                "const": false
              }
            }
          },
          "images": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "not": {
                    "enum": [
                      "latest",
                      "dev",
                      "release-required"
                    ]
                  }
                }
              }
            }
          },
          "external": {
            "type": "object",
            "properties": {
              "postgresCidrs": {
                "type": "array",
                "minItems": 1
              },
              "paymentProviderCidrs": {
                "type": "array",
                "minItems": 1
              },
              "secretProviderCidrs": {
                "type": "array",
                "minItems": 1
              },
              "modelProviderCidrs": {
                "type": "array",
                "minItems": 1
              },
              "telemetryCollectorCidrs": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "observability": {
            "type": "object",
            "properties": {
              "otlpEndpoint": {
                "type": "string",
                "pattern": "^https://"
              },
              "prometheusRulesEnabled": {
                "const": true
              }
            }
          },
          "ingress": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "networkPolicy": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mobileAuth": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "mobileAuth": {
            "type": "object",
            "properties": {
              "keycloakAdminApiUrl": {
                "type": "string",
                "pattern": "^https?://[^/@?#]+(?:/[^?#]*)?$"
              },
              "keycloakProvisionerTokenUrl": {
                "type": "string",
                "pattern": "^https?://[^/@?#]+(?:/[^?#]*)?$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mobileAuth": {
                  "type": "object",
                  "properties": {
                    "smsProvider": {
                      "enum": [
                        "http",
                        "http-generated"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "mobileAuth": {
                  "type": "object",
                  "properties": {
                    "smsEndpoint": {
                      "type": "string",
                      "pattern": "^https?://[^/@?#]+(?:/[^?#]*)?$"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "mobileAuth": {
                  "type": "object",
                  "properties": {
                    "aliyunRegisterTemplate": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aliyunLoginTemplate": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mobileAuth": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "keycloak": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "type": "object",
            "properties": {
              "keycloak": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "not": {
                      "const": "quay.io/keycloak/keycloak"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "commerce": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "commerce": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https?://[^/@?#]+(?:/[^?#]*)?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "billing": {
            "type": "object",
            "properties": {
              "paymentProvider": {
                "const": "h3c_mall"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "commerce": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "environment": {
                "not": {
                  "enum": [
                    "development",
                    "test"
                  ]
                }
              }
            }
          },
          "mobileAuth": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "mobileAuth": {
            "type": "object",
            "properties": {
              "keycloakAdminApiUrl": {
                "type": "string",
                "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
              },
              "keycloakProvisionerTokenUrl": {
                "type": "string",
                "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
              }
            }
          },
          "external": {
            "type": "object",
            "properties": {
              "smsProviderCidrs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mobileAuth": {
                  "type": "object",
                  "properties": {
                    "smsProvider": {
                      "enum": [
                        "http",
                        "http-generated"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "mobileAuth": {
                  "type": "object",
                  "properties": {
                    "smsEndpoint": {
                      "type": "string",
                      "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "environment": {
                "not": {
                  "enum": [
                    "development",
                    "test"
                  ]
                }
              }
            }
          },
          "commerce": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "commerce": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
              }
            }
          },
          "external": {
            "type": "object",
            "properties": {
              "commerceProviderCidrs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
