        {
          "type": "bind",
          "source": "/opt/fixture-bind-true",
          "target": "/true",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/opt/fixture-bind-short",
          "target": "/short",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ]
    }
  }
}