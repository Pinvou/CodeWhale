{
  "name": "public-bind-config-probe",
  "networks": {
    "default": {
      "name": "public-bind-config-probe_default",
      "ipam": {}
    }
  },
  "services": {
    "probe": {
      "command": null,
      "entrypoint": null,
      "image": "registry.example.invalid/config-only:never-run",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/fixture-bind-false",
          "target": "/false",
