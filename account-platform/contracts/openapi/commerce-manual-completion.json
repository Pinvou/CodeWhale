{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Commerce customer synchronization manual completion",
    "version": "1.0.0",
    "description": "Refs #1632. Operator-only Account HTTP surface; no implicit Portal proxy or GUI. One case per original job/provider/adapter. Immutable human-attested controlled-record references are not machine-verified supplier results. Confirmation attests authoritative original success or completed-no-effect evidence covering all original attempts. Two independent currently authorized users are required. Only matching active generation can become READY; stale/closed subjects preserve evidence only. No-effect never means sync success. No external execution or automatic redispatch is authorized. Newer evidence invalidates older proposals. Unknown replies recover the same case/observation; receipts remain immutable. In-flight callbacks remain separate immutable data-only evidence, with database sequence pagination. New callback evidence invalidates an open proposal; evidence after completion does not rewrite the receipt. New references are refused for retired/closed subjects; preserve the controlled record and digest instead."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin/v1/commerce-repairs": {
      "get": {
        "operationId": "adminCommerceRepairs",
        "x-required-permission": "platform.commerce.repairs.read",
        "responses": {
          "200": {
            "description": "Durable redacted original binding or completion receipt",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Queue"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed operator protocol"
          },
          "401": {
            "description": "OIDC authentication required; preserve any prior uncertain command"
          },
          "403": {
            "description": "Current permission or independent human authority denied; does not disprove an earlier commit"
          },
          "404": {
            "description": "Original case, job or observation not found"
          },
          "409": {
            "description": "Original binding, evidence, version, state or idempotent input conflicts"
          },
          "429": {
            "description": "Existing HTTP admission limit"
          },
          "500": {
            "description": "Infrastructure failure; recover the original case/observation identity"
          },
          "503": {
            "description": "Authorization or installed repair capability unavailable"
          }
        },
        "parameters": [
          {
            "name": "after_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ]
      },
      "post": {
        "operationId": "adminQuarantineCommerceRepair",
        "x-required-permission": "platform.commerce.repairs.request",
        "responses": {
          "200": {
            "description": "Durable redacted original binding or completion receipt",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Case"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed operator protocol"
          },
          "401": {
            "description": "OIDC authentication required; preserve any prior uncertain command"
          },
          "403": {
            "description": "Current permission or independent human authority denied; does not disprove an earlier commit"
          },
          "404": {
            "description": "Original case, job or observation not found"
          },
          "409": {
            "description": "Original binding, evidence, version, state or idempotent input conflicts"
          },
          "429": {
            "description": "Existing HTTP admission limit"
          },
          "500": {
            "description": "Infrastructure failure; recover the original case/observation identity"
          },
          "503": {
            "description": "Authorization or installed repair capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "description": "Exactly application/json, at most8192bytes. Duplicate keys, case-folded aliases, unknown members, UUID aliases, extra query fields and trailing documents are rejected.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Quarantine"
              }
            }
          }
        }
      }
    },
