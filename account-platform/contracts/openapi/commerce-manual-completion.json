  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "OIDC JWT",
        "description": "Human session with issuer, subject, session id and auth time; independent current platform roles checked in Account."
      }
    },
    "schemas": {
      "Case": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "job_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "mapping_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "approved_observation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "reviewer_user_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "mapping_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "subject_type": {
            "enum": [
              "USER",
              "ORGANIZATION"
            ]
          },
          "subject_lifecycle_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "provider_id": {
            "type": "string"
          },
          "adapter_version": {
            "type": "string"
          },
          "task_category": {
            "enum": [
              "CUSTOMER_PROVISIONING",
              "PROFILE_SYNC"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "resolution": {
            "enum": [
              "SUCCEEDED_CURRENT",
              "SUCCEEDED_EVIDENCE_ONLY",
              "ENDED_NO_EFFECT"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "job_id",
          "mapping_id",
          "subject_id",
          "mapping_version",
          "subject_type",
          "subject_lifecycle_version",
          "provider_id",
          "adapter_version",
          "task_category",
          "attempts",
          "version",
          "status",
          "created_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RESOLVED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "resolution",
                "approved_observation_id",
                "reviewer_user_id",
                "resolved_at"
              ],
              "properties": {
                "resolution": {
                  "enum": [
                    "SUCCEEDED_CURRENT",
                    "SUCCEEDED_EVIDENCE_ONLY",
                    "ENDED_NO_EFFECT"
                  ]
                },
                "approved_observation_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "reviewer_user_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "resolved_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "resolution"
                    ],
                    "properties": {
                      "resolution": {}
                    }
                  },
                  {
                    "required": [
                      "approved_observation_id"
                    ],
                    "properties": {
                      "approved_observation_id": {}
                    }
                  },
                  {
                    "required": [
                      "reviewer_user_id"
                    ],
                    "properties": {
                      "reviewer_user_id": {}
                    }
                  },
                  {
                    "required": [
                      "resolved_at"
                    ],
                    "properties": {
                      "resolved_at": {}
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "case_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "case_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "outcome": {
            "enum": [
              "UNCONFIRMED",
              "SUCCEEDED",
              "ENDED_NO_EFFECT"
            ]
          },
          "evidence_reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "all_attempts_ended": {
            "type": "boolean"
          },
          "external_reference_redacted": {
            "type": "string",
            "pattern": "^(|\\*{3}[A-Za-z0-9]{1,8})$"
          },
          "proposer_user_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "case_id",
          "case_version",
          "outcome",
          "evidence_reference",
          "evidence_sha256",
          "all_attempts_ended",
          "proposer_user_id",
          "created_at"
        ]
      },
      "Quarantine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "job_id"
        ]
      },
      "ObservationInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "UNCONFIRMED",
              "SUCCEEDED",
              "ENDED_NO_EFFECT"
            ]
          },
          "evidence_reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "all_attempts_ended": {
            "type": "boolean"
          },
          "external_reference_redacted": {
            "type": "string",
            "pattern": "^(|\\*{3}[A-Za-z0-9]{1,8})$"
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "observation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "expected_version",
          "observation_id",
          "outcome",
          "evidence_reference",
          "evidence_sha256"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "SUCCEEDED",
                    "ENDED_NO_EFFECT"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "all_attempts_ended"
              ],
              "properties": {
                "all_attempts_ended": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "UNCONFIRMED",
                    "ENDED_NO_EFFECT"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "external_reference_redacted": {
                  "const": ""
                }
              }
            }
          }
        ]
      },
      "Confirmation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "observation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "expected_version",
          "observation_id"
        ]
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case": {
            "$ref": "#/components/schemas/Case"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "maxItems": 100
          },
          "more_observations": {
            "type": "boolean"
          },
          "callbacks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Callback"
            },
            "maxItems": 100
          },
          "more_callbacks": {
            "type": "boolean"
          }
        },
        "required": [
          "case",
          "observations",
          "more_observations",
          "callbacks",
          "more_callbacks"
        ]
      },
      "Queue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Case"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Callback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "case_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "SUCCEEDED",
              "PROVIDER_ERROR"
            ]
          },
          "external_reference_redacted": {
            "type": "string",
            "pattern": "^(|\\*{3}[A-Za-z0-9]{1,8})$"
          },
          "after_completion": {
            "type": "boolean"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sequence",
          "case_id",
          "attempts",
          "kind",
          "after_completion",
          "recorded_at"
        ]
      }
    }
  }
}
