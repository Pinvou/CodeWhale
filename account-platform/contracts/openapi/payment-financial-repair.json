{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment financial repair owner precheck",
    "version": "1"
  },
  "paths": {
    "/admin/v2/approval-command-prechecks": {
      "post": {
        "operationId": "accountPaymentFinancialRepairPrecheck",
        "description": "current Account actor + platform.billing.repairs.request; read-only closed unique-key JSON; 65536-byte bound and existing 2-second transport deadline. No claim, approval or effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed owner frozen projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecheckProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority refused"
          },
          "503": {
            "description": "Owner unavailable; INACTIVE permits read-only precheck preparation"
          },
          "422": {
            "description": "Closed owner projection unavailable for selected facts"
          },
          "504": {
            "description": "Existing read-only precheck deadline expired"
          }
        }
      }
    },
    "/internal/v1/approval-command-prechecks": {
      "post": {
        "operationId": "billingPaymentFinancialRepairPrecheck",
        "description": "Account workload + internal.billing.approval-proof.read; read-only closed unique-key JSON; 65536-byte bound and existing 2-second transport deadline. No claim, approval or effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed owner frozen projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecheckProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority refused"
          },
          "503": {
            "description": "Owner unavailable; INACTIVE permits read-only precheck preparation"
          },
          "422": {
            "description": "Closed owner projection unavailable for selected facts"
          },
          "504": {
            "description": "Existing read-only precheck deadline expired"
          }
        }
      }
    },
    "/api/admin/account/admin/v2/approval-command-prechecks": {
      "post": {
        "operationId": "portalPaymentFinancialRepairPrecheck",
        "description": "current OIDC session + CSRF, forwards Account actor only; read-only closed unique-key JSON; 65536-byte bound and existing 2-second transport deadline. No claim, approval or effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed owner frozen projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecheckProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority refused"
          },
          "503": {
            "description": "Owner unavailable; INACTIVE permits read-only precheck preparation"
          },
          "422": {
            "description": "Closed owner projection unavailable for selected facts"
          },
          "504": {
            "description": "Existing read-only precheck deadline expired"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PrecheckRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_type",
          "target_resource_id",
          "payment_evidence_id",
          "reason_code"
        ],
        "properties": {
          "command_type": {
            "const": "PAYMENT_FINANCIAL_REPAIR"
          },
          "target_resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "payment_evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason_code": {
            "const": "CONFIRMED_PAYMENT_NOT_CREDITED"
          }
        }
      },
      "NormalizedCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payment_order_id",
          "payment_evidence_id",
          "reason_code"
        ],
        "properties": {
          "payment_order_id": {
            "type": "string",
            "format": "uuid"
          },
          "payment_evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason_code": {
            "const": "CONFIRMED_PAYMENT_NOT_CREDITED"
          }
        }
      },
      "CriticalResourceVersions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payment_order_updated_at",
          "facts_digest",
          "policy_version"
        ],
        "properties": {
          "payment_order_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "facts_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policy_version": {
            "const": 1
          }
        }
      },
      "FinancialSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount_fen",
          "credit_microcredits",
          "wallet_version",
          "applied_to_receivables",
          "provider_transaction_id",
          "wallet_id"
        ],
        "properties": {
          "amount_fen": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "credit_microcredits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "wallet_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "applied_to_receivables": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "provider_transaction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PrecheckProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_type",
          "policy_version",
          "snapshot_schema_version",
          "target_resource_type",
          "target_resource_id",
          "normalized_command",
          "critical_resource_versions",
          "financial_snapshot"
        ],
        "properties": {
          "command_type": {
            "const": "PAYMENT_FINANCIAL_REPAIR"
          },
          "policy_version": {
            "const": 1
          },
          "snapshot_schema_version": {
            "const": 1
          },
          "target_resource_type": {
            "const": "PAYMENT_ORDER"
          },
          "target_resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "normalized_command": {
            "$ref": "#/components/schemas/NormalizedCommand"
          },
          "critical_resource_versions": {
            "$ref": "#/components/schemas/CriticalResourceVersions"
          },
          "financial_snapshot": {
            "$ref": "#/components/schemas/FinancialSnapshot"
          }
        }
      }
    }
  }
}
