{
  "openapi": "3.1.0",
  "info": {
    "title": "Receivable write-off owner precheck",
    "version": "1"
  },
  "paths": {
    "/admin/v2/approval-command-prechecks": {
      "post": {
        "operationId": "accountReceivableWriteOffPrecheck",
        "description": "current Account actor + platform.billing.repairs.request; read-only closed unique-key JSON; 65536-byte bound and existing 2-second transport deadline. No claim, approval or effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed owner frozen projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecheckProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority refused"
          },
          "503": {
            "description": "Owner unavailable; INACTIVE permits read-only precheck preparation"
          },
          "422": {
            "description": "Closed owner projection unavailable for selected facts"
          },
          "504": {
            "description": "Existing read-only precheck deadline expired"
          }
        }
      }
    },
    "/internal/v1/approval-command-prechecks": {
      "post": {
        "operationId": "billingReceivableWriteOffPrecheck",
        "description": "Account workload + internal.billing.approval-proof.read; read-only closed unique-key JSON; 65536-byte bound and existing 2-second transport deadline. No claim, approval or effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed owner frozen projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecheckProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority refused"
          },
          "503": {
            "description": "Owner unavailable; INACTIVE permits read-only precheck preparation"
          },
          "422": {
            "description": "Closed owner projection unavailable for selected facts"
          },
          "504": {
            "description": "Existing read-only precheck deadline expired"
          }
        }
      }
    },
    "/api/admin/account/admin/v2/approval-command-prechecks": {
      "post": {
        "operationId": "portalReceivableWriteOffPrecheck",
        "description": "current OIDC session + CSRF, forwards Account actor only; read-only closed unique-key JSON; 65536-byte bound and existing 2-second transport deadline. No claim, approval or effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed owner frozen projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecheckProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority refused"
          },
          "503": {
            "description": "Owner unavailable; INACTIVE permits read-only precheck preparation"
          },
          "422": {
            "description": "Closed owner projection unavailable for selected facts"
          },
          "504": {
            "description": "Existing read-only precheck deadline expired"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PrecheckRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_type",
          "target_resource_id",
          "write_off_microcredits",
          "expected_version",
          "reason_code"
        ],
        "properties": {
          "command_type": {
            "const": "RECEIVABLE_WRITE_OFF"
          },
          "target_resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "write_off_microcredits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "reason_code": {
            "const": "APPROVED_RECEIVABLE_WRITE_OFF"
          }
        }
      },
      "NormalizedCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receivable_id",
          "write_off_microcredits",
          "expected_receivable_version",
          "reason_code"
        ],
        "properties": {
          "receivable_id": {
            "type": "string",
            "format": "uuid"
          },
          "write_off_microcredits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "expected_receivable_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "reason_code": {
            "const": "APPROVED_RECEIVABLE_WRITE_OFF"
          }
        }
      },
      "CriticalResourceVersions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receivable_version",
          "facts_digest",
          "policy_version"
        ],
        "properties": {
          "receivable_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "facts_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policy_version": {
            "const": 1
          }
        }
      },
      "FinancialSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "write_off_microcredits",
          "outstanding_microcredits",
          "settled_microcredits",
          "original_microcredits",
          "wallet_receivable_microcredits",
          "source_type",
          "source_reference"
        ],
        "properties": {
          "write_off_microcredits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "outstanding_microcredits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "settled_microcredits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "original_microcredits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "wallet_receivable_microcredits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "source_type": {
            "const": "USAGE_OVERAGE"
          },
          "source_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "PrecheckProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_type",
          "policy_version",
          "snapshot_schema_version",
          "target_resource_type",
          "target_resource_id",
          "normalized_command",
          "critical_resource_versions",
          "financial_snapshot"
        ],
        "properties": {
          "command_type": {
            "const": "RECEIVABLE_WRITE_OFF"
          },
          "policy_version": {
            "const": 1
          },
          "snapshot_schema_version": {
            "const": 1
          },
          "target_resource_type": {
            "const": "RECEIVABLE"
          },
          "target_resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "normalized_command": {
            "$ref": "#/components/schemas/NormalizedCommand"
          },
          "critical_resource_versions": {
            "$ref": "#/components/schemas/CriticalResourceVersions"
          },
          "financial_snapshot": {
            "$ref": "#/components/schemas/FinancialSnapshot"
          }
        }
      }
    }
  }
}
