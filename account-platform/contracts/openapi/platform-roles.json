{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform role administration",
    "version": "1.0.0",
    "description": "Restores ADM-05 under existing permissions, source/time/PII/high-privilege boundaries. Portal proxies these through authenticated session and CSRF. Unknown ACKs retain the original command; no replacement-key or cross-reload automatic retry."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin/v1/roles": {
      "get": {
        "operationId": "adminPlatformRoles",
        "x-required-permission": "platform.roles.read",
        "responses": {
          "200": {
            "description": "Installed platform role definitions and delivered atomic permissions"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/RoleManagementUnavailable"
          }
        }
      }
    },
    "/admin/v1/role-bindings": {
      "get": {
        "operationId": "adminPlatformRoleBindings",
        "x-required-permission": "platform.roles.read",
        "parameters": [
          {
            "in": "query",
            "name": "user_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Optional exact target user; at most 500 platform associations."
          }
        ],
        "responses": {
          "200": {
            "description": "Platform-only association projection, ordered and bounded to 500 entries. truncated is true only when more matching entries exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "truncated"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 500,
                      "items": {
                        "$ref": "#/components/schemas/RoleBinding"
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "409": {
            "description": "ACCOUNT_CONFLICT: organization_id or unit_id query parameters are present, or a nonempty user_id is malformed or the nil UUID. A valid user_id without associations returns an empty successful list.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "ACCOUNT_CONFLICT"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/RoleManagementUnavailable"
          }
        }
      },
      "post": {
        "operationId": "adminGrantPlatformRoleBinding",
        "x-required-permission": "platform.roles.assign",
        "x-command-type": "ACCOUNT_ROLE_BINDING_GRANT",
        "x-approval-mode": "AUDIT_ONLY",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Grant"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Original grant current projection, including revoked/expired replay; no repeat write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleBinding"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_JSON: malformed JSON, unknown fields, invalid field types or UUID/date-time values, multiple JSON values, or a body exceeding the decoder limit. Rejected before the role write is invoked.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "INVALID_JSON"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "AUTH_REQUIRED for a missing, malformed or invalid bearer token; RECENT_AUTHENTICATION_REQUIRED is an explicit no-write first invocation rejection for a temporary PII export grant without recent authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "AUTH_REQUIRED",
                            "RECENT_AUTHENTICATION_REQUIRED"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleWriteForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RoleBindingNotFound"
          },
          "409": {
            "description": "ACCOUNT_CONFLICT: invalid grant fields, non-platform scope, inactive target, unknown or protected/unassignable role, invalid time/PII duration or reason, changed or ambiguous original grant intent, or a mapped insert constraint conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "ACCOUNT_CONFLICT"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/RoleWriteUnavailable"
          }
        }
      }
    },
    "/admin/v1/role-bindings/{binding_id}": {
      "parameters": [
        {
          "in": "path",
          "name": "binding_id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "operationId": "adminRevokePlatformRoleBinding",
        "x-required-permission": "platform.roles.assign",
        "x-command-type": "ACCOUNT_ROLE_BINDING_REVOKE",
        "x-approval-mode": "AUDIT_ONLY",
        "responses": {
          "200": {
            "description": "Authoritative revoked/expired projection; no role reactivation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleBinding"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: binding_id cannot be parsed as a UUID. A parseable but absent UUID instead returns NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "INVALID_REQUEST"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/RoleWriteForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RoleBindingNotFound"
          },
          "409": {
            "description": "ACCOUNT_CONFLICT: the role is protected or unassignable and requires its dedicated lifecycle.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "ACCOUNT_CONFLICT"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/RoleWriteUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Grant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "role_code",
          "idempotency_key"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "role_code": {
            "type": "string"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          },
          "reason": {
            "type": "string",
            "description": "Trimmed, exact original reason. Temporary PII grants retain existing UTF-8 byte length 10..500 and recent-auth checks."
          }
        }
      },
      "RoleBinding": {
        "type": "object",
        "required": [
          "binding_id",
          "user_id",
          "role_code",
          "scope",
          "starts_at",
          "status",
          "grant_source"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "role_code": {
            "type": "string"
          },
          "scope": {
            "const": "PLATFORM"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "SCHEDULED",
              "EXPIRED",
              "REVOKED"
            ]
          },
          "grant_source": {
            "type": "string"
          },
          "created_by": {
            "type": "string",
            "format": "uuid"
          },
          "revoked_by": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Flat JSON error body with required code and message. api.WriteError (api.Error) omits request_id when no correlation ID is available and does not populate details on these routes. The HTTP host CLOCK_UNSAFE response always omits request_id.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "AuthenticationRequired": {
        "description": "AUTH_REQUIRED: missing, malformed or invalid bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTH_REQUIRED"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "PermissionDenied": {
        "description": "PERMISSION_DENIED: the current principal lacks the required platform permission.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "PERMISSION_DENIED"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "RoleWriteForbidden": {
        "description": "PERMISSION_DENIED at the route permission check, or ACCOUNT_FORBIDDEN if the live human actor or assign authority is no longer valid when the write transaction rechecks it.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "PERMISSION_DENIED",
                        "ACCOUNT_FORBIDDEN"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "RoleManagementUnavailable": {
        "description": "AUTHORIZATION_UNAVAILABLE if the permission repository is missing or its check fails; ROLE_MANAGEMENT_UNAVAILABLE if the role management repository capability is missing after authorization succeeds.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTHORIZATION_UNAVAILABLE",
                        "ROLE_MANAGEMENT_UNAVAILABLE"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "InternalError": {
        "description": "INTERNAL_ERROR: an unclassified repository query, scan, transaction, audit or outbox failure. Serialization failures on these routes also use this response.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "INTERNAL_ERROR"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "RoleBindingNotFound": {
        "description": "NOT_FOUND: the target user (grant), or a platform association or its target user (revoke), does not exist. Non-platform associations are not exposed by revoke.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "NOT_FOUND"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "RateLimited": {
        "description": "RATE_LIMITED: the shared HTTP host admission budget is exhausted when rate limiting is enabled; this is not a role-specific quota. Retry-After is 1 second.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "RATE_LIMITED"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Seconds before retrying.",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        }
      },
      "RoleWriteUnavailable": {
        "description": "AUTHORIZATION_UNAVAILABLE if the permission repository is missing or its check fails; ROLE_MANAGEMENT_UNAVAILABLE if the role management repository capability is missing after authorization succeeds. CLOCK_UNSAFE if the production HTTP host trusted-clock check rejects this write before the Account handler; that response contains only code and message, without request_id.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTHORIZATION_UNAVAILABLE",
                        "ROLE_MANAGEMENT_UNAVAILABLE",
                        "CLOCK_UNSAFE"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
