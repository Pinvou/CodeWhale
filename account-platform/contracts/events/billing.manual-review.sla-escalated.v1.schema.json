{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinvou.com/schemas/billing.manual-review.sla-escalated.v1.json",
  "title": "billing.manual-review.sla-escalated.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "aggregate_id", "aggregate_version", "occurred_at", "trace_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "billing.manual-review.sla-escalated.v1" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "aggregate_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "stage"],
      "properties": {
        "case_id": { "type": "string", "format": "uuid" },
        "stage": { "enum": ["CLAIM_OVERDUE", "FIRST_RESPONSE_OVERDUE", "MITIGATION_OVERDUE", "RESOLUTION_OVERDUE"] }
      }
    }
  }
}
