# Generate with: openssl rand -base64 48
PINVOU_UPDATE_ADMIN_TOKEN=replace-with-at-least-32-random-characters

PINVOU_UPDATE_HOST=127.0.0.1
PINVOU_UPDATE_PORT=8792
PINVOU_UPDATE_CONSOLE_BASE_PATH=/pinvou3/release-console
PINVOU_UPDATE_PUBLIC_ROOT=/var/www/pinvou3
PINVOU_UPDATE_STATE_ROOT=/var/lib/pinvou-update-console
PINVOU_UPDATE_PUBLIC_BASE_URL=https://pinvou.com/pinvou3
PINVOU_UPDATE_MAX_UPLOAD_BYTES=4294967296
PINVOU_UPDATE_UPLOAD_IDLE_TIMEOUT_MS=120000
PINVOU_UPDATE_ONLINE_VERIFY_TIMEOUT_MS=900000
# Only these direct peers may supply X-Real-IP. Docker bridge gateways commonly use 172.16/12.
PINVOU_UPDATE_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
PINVOU_UPDATE_AUTH_FAILURE_LIMIT=5
PINVOU_UPDATE_AUTH_FAILURE_WINDOW_MS=300000
PINVOU_UPDATE_AUTH_BLOCK_MS=900000
PINVOU_UPDATE_AUTH_LIMITER_TTL_MS=3600000
PINVOU_UPDATE_AUTH_LIMITER_MAX_ENTRIES=10000
