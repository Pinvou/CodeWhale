# DEV-01 desktop endpoint enrollment registry. DEV-06 will wire this module into
# the Relay dispatcher; setting these variables alone does not enable pairing.
PINVOU_REMOTE_ENROLLMENT_DEPLOYMENT=self_hosted
# The parent must already exist. The Relay creates and protects only the final
# dedicated remote-controller directory.
PINVOU_REMOTE_CONTROLLER_STATE_PATH=C:\ProgramData\Pinvou\remote-controller\state.json
# Required alias-safety input; this module never reads or changes the v2 state.
PINVOU_REMOTE_STATE_PATH=C:\ProgramData\Pinvou\web-v2-state.json
PINVOU_REMOTE_ENROLLMENT_HMAC_KEY_ID=replace-with-a-stable-key-id
PINVOU_REMOTE_ENROLLMENT_HMAC_KEY=replace-with-at-least-32-random-bytes

# Enable the desktop-controller v1 dispatcher only after all controller
# credentials below are provisioned. Pairing and enrollment keys must be
# independently generated and retained across Relay restarts.
PINVOU_DESKTOP_CONTROLLER_ENABLED=0
PINVOU_REMOTE_PAIRING_HMAC_KEY_ID=replace-with-a-stable-pairing-key-id
PINVOU_REMOTE_PAIRING_HMAC_KEY=replace-with-at-least-32-independent-random-bytes
PINVOU_REMOTE_RELAY_SIGNING_KEY_ID=replace-with-a-pinned-ed25519-key-id
# Canonical base64 of an Ed25519 PKCS#8 DER private key. Never commit a value.
PINVOU_REMOTE_RELAY_SIGNING_PRIVATE_KEY_B64=replace-at-deploy-time

# Anonymous TOFU is forbidden in official/self-hosted production. Temporary
# self-registration requires all three explicit non-production settings below.
# NODE_ENV=development
# PINVOU_REMOTE_ENROLLMENT_DEPLOYMENT=development
# PINVOU_REMOTE_ENROLLMENT_DEVELOPMENT_TOFU=1
