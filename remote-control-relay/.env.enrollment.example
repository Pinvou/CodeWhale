# DEV-01 desktop endpoint enrollment registry. DEV-06 will wire this module into
# the Relay dispatcher; setting these variables alone does not enable pairing.
PINVOU_REMOTE_ENROLLMENT_DEPLOYMENT=self_hosted
PINVOU_REMOTE_CONTROLLER_STATE_PATH=C:\ProgramData\Pinvou\remote-controller-state.json
PINVOU_REMOTE_ENROLLMENT_HMAC_KEY_ID=replace-with-a-stable-key-id
PINVOU_REMOTE_ENROLLMENT_HMAC_KEY=replace-with-at-least-32-random-bytes

# Anonymous TOFU is forbidden in official/self-hosted production. Temporary
# self-registration requires all three explicit non-production settings below.
# NODE_ENV=development
# PINVOU_REMOTE_ENROLLMENT_DEPLOYMENT=development
# PINVOU_REMOTE_ENROLLMENT_DEVELOPMENT_TOFU=1
