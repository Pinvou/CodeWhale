# Enrollment-aware gateway is the only public listener during legacy v2 rollback.
PINVOU_REMOTE_GATEWAY_HOST=127.0.0.1
PINVOU_REMOTE_GATEWAY_PORT=8790
# The nginx sample is for these defaults only. After overrides, generate/check
# it with scripts/enrollment-nginx-config.js using this same environment.
# PINVOU_REMOTE_PUBLIC_BASE_PATH=/pinvou3/remote
# PORT=8787
# Optional authenticated online rollback coverage listener, NEVER public/proxied.
# Supply all three in protected deployment configuration to enable it.
# Key is deliberately empty: generate a new secret (32–4096 UTF-8 bytes),
# independent of enrollment/pairing HMAC keys; never commit a filled-in copy.
# PINVOU_REMOTE_GATEWAY_CONTROL_HOST=127.0.0.1
# PINVOU_REMOTE_GATEWAY_CONTROL_PORT=8791
# PINVOU_REMOTE_GATEWAY_CONTROL_KEY=
PINVOU_REMOTE_LEGACY_RELAY_URL=ws://127.0.0.1:8787/pinvou3/remote/ws
PINVOU_REMOTE_LEGACY_RELAY_BIND_HOST=127.0.0.1
# Only these immediate proxies may supply X-Forwarded-For. For a same-host
# nginx deployment, keep this as the literal loopback address nginx uses.
PINVOU_REMOTE_GATEWAY_TRUSTED_PROXY_IPS=127.0.0.1
PINVOU_REMOTE_ALLOWED_WEB_ORIGINS=https://pinvou.com
# Bound the in-memory per-source rate-limit table under high-cardinality traffic.
PINVOU_ENROLLMENT_GATEWAY_MAX_SOURCE_BUCKETS=100000
# JSON array; list every DNS/public route before rollback.
PINVOU_REMOTE_PUBLIC_ENTRYPOINTS_JSON=["https://pinvou.com/pinvou3/remote"]
# The legacy Relay itself must also bind loopback-only.
PINVOU_REMOTE_HOST=127.0.0.1
